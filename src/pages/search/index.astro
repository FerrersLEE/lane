---
import BaseLayout from "../../layouts/BaseLayout.astro";
---

<BaseLayout title="搜索 · Lane · 研究手帖" description="在笔记和项目中搜索关键词。">
  <header class="page-head reveal">
    <p class="eyebrow">/ 04 — Search</p>
    <h1>全文检索</h1>
    <p class="page-desc">在所有笔记和项目中检索标题、标签、摘要与正文。</p>
  </header>

  <div class="search-input-wrap reveal reveal-d1">
    <span class="search-prefix">$</span>
    <input
      id="search-input"
      aria-label="搜索文章"
      type="search"
      placeholder="grep -r '关键词' ./notes ..."
      autocomplete="off"
      class="search-input"
    />
  </div>
  <p class="search-hint reveal reveal-d1">按 <kbd>/</kbd> 快速聚焦 · <kbd>Esc</kbd> 清空</p>

  <div id="search-stats" class="kicker" style="margin-top:20px;min-height:1.4rem"></div>
  <div id="search-results" style="margin-top:18px"></div>

  <script is:inline>
    (function() {
      var index = [];
      var loaded = false;

      var input = document.getElementById('search-input');
      var resultsEl = document.getElementById('search-results');
      var statsEl = document.getElementById('search-stats');

      function loadIndex() {
        if (loaded) return Promise.resolve();
        return fetch('/search-index.json')
          .then(function(res) { return res.json(); })
          .then(function(data) {
            index = data;
            loaded = true;
          })
          .catch(function() {
            if (statsEl) statsEl.textContent = '// 搜索索引加载失败';
          });
      }

      function highlight(text, query) {
        if (!query) return text;
        var escaped = query.replace(/[.*+?^${}()|[\]\\]/g, '\\$&');
        var regex = new RegExp('(' + escaped + ')', 'gi');
        return text.replace(regex, '<mark>$1</mark>');
      }

      function search(query) {
        var q = query.trim().toLowerCase();
        if (!q) return [];

        return index
          .map(function(item) {
            var titleMatch = item.title.toLowerCase().includes(q);
            var descMatch = item.description.toLowerCase().includes(q);
            var tagMatch = item.tags.some(function(t) { return t.toLowerCase().includes(q); });
            var contentMatch = item.content.toLowerCase().includes(q);

            var score = 0;
            if (titleMatch) score += 10;
            if (tagMatch) score += 5;
            if (descMatch) score += 3;
            if (contentMatch) score += 1;

            return { item: item, score: score };
          })
          .filter(function(r) { return r.score > 0; })
          .sort(function(a, b) { return b.score - a.score; })
          .map(function(r) { return r.item; });
      }

      function getSnippet(content, query) {
        var q = query.toLowerCase();
        var idx = content.toLowerCase().indexOf(q);
        if (idx === -1) return content.slice(0, 120) + '...';
        var start = Math.max(0, idx - 40);
        var end = Math.min(content.length, idx + q.length + 80);
        return (start > 0 ? '...' : '') + content.slice(start, end) + (end < content.length ? '...' : '');
      }

      function escapeHtml(s) {
        return s.replace(/[&<>"]/g, function(c) {
          return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[c];
        });
      }

      function renderResults(results, query) {
        if (!query.trim()) {
          resultsEl.innerHTML = '';
          statsEl.textContent = '// 输入关键词开始搜索';
          return;
        }

        if (results.length === 0) {
          resultsEl.innerHTML = '';
          statsEl.textContent = '// 没有找到与 “' + escapeHtml(query) + '” 相关的内容';
          return;
        }

        statsEl.textContent = '// 找到 ' + results.length + ' 个结果';

        resultsEl.innerHTML = results.map(function(item) {
          var typeLabel = item.type === 'note' ? '笔记' : '项目';
          var snippet = item.content ? getSnippet(item.content, query) : item.description;
          var tagsHtml = item.tags.map(function(t) {
            return '<span class="pill">#' + escapeHtml(t) + '</span>';
          }).join('');
          return (
            '<a class="card-hard search-result-card reveal" href="' + item.url + '">' +
              '<div class="result-top">' +
                '<span class="pill pill-solid">' + typeLabel + '</span>' +
                '<span>' + new Date(item.published).toLocaleDateString('zh-CN') + '</span>' +
              '</div>' +
              '<h3>' + highlight(escapeHtml(item.title), query) + '</h3>' +
              '<p class="result-snippet">' + highlight(escapeHtml(snippet), query) + '</p>' +
              '<div class="result-tags">' + tagsHtml + '</div>' +
            '</a>'
          );
        }).join('');
      }

      var debounceTimer = null;
      if (input) {
        input.addEventListener('input', function(e) {
          var query = (e.target || {}).value || '';
          if (debounceTimer) clearTimeout(debounceTimer);
          debounceTimer = setTimeout(function() {
            loadIndex().then(function() {
              renderResults(search(query), query);
            });
          }, 150);
        });
      }

      // 键盘快捷键：/ 聚焦，Esc 清空
      document.addEventListener('keydown', function(e) {
        if (e.key === '/' && document.activeElement !== input) {
          e.preventDefault();
          input.focus();
        }
        if (e.key === 'Escape' && document.activeElement === input) {
          input.value = '';
          renderResults([], '');
          input.blur();
        }
      });

      // 支持 URL 参数直接搜索
      var params = new URLSearchParams(window.location.search);
      var q = params.get('q');
      if (q && input) {
        input.value = q;
        loadIndex().then(function() {
          renderResults(search(q), q);
        });
      } else if (statsEl) {
        statsEl.textContent = '// 输入关键词开始搜索';
      }
    })();
  </script>
</BaseLayout>
