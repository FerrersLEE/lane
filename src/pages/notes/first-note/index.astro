---
import { getEntry, render } from "astro:content"; import BaseLayout from "../../../layouts/BaseLayout.astro";
const entry=await getEntry("notes","first-note");
if (!entry) throw new Error("Missing note: first-note");
const {Content}=await render(entry);
---
<BaseLayout title={`${entry.data.title} · 你的名字`} description={entry.data.description}><article class="article"><div class="meta">{entry.data.published.toLocaleDateString("zh-CN")} · {entry.data.tags.map((tag)=>`#${tag}`).join(" ")}</div><h1>{entry.data.title}</h1><p class="lead">{entry.data.description}</p><div class="article-tools"><button data-copy>复制代码</button><nav class="toc" aria-label="文章目录"></nav></div><div class="article-content"><Content /></div></article><script is:inline>{`document.querySelector('[data-copy]')?.addEventListener('click',async()=>{const blocks=[...document.querySelectorAll('pre code')];await navigator.clipboard.writeText(blocks.map(b=>b.textContent).join('\\n'));alert('代码已复制')});const toc=document.querySelector('.toc');document.querySelectorAll('.article-content h2,.article-content h3').forEach((h,i)=>{h.id=h.id||'section-'+i;const a=document.createElement('a');a.href='#'+h.id;a.textContent=h.textContent;toc?.append(a)});`}</script></BaseLayout>


