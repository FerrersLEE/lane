---
import { getCollection, render } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";

export async function getStaticPaths() {
  const entries = (await getCollection("programs", ({ data }) => !data.draft))
    .sort((a, b) => b.data.published.valueOf() - a.data.published.valueOf());
  return entries.map((entry) => ({ params: { slug: entry.id }, props: { entry, allEntries: entries } }));
}

const { entry, allEntries } = Astro.props;
const { Content } = await render(entry);

// 阅读时间估算
const plainText = (entry.body ?? "").replace(/[#*`>\-\[\]_~!\[\]()]/g, "").replace(/\s+/g, "");
const readingMinutes = Math.max(1, Math.ceil(plainText.length / 400));

// 上下篇
const currentIndex = allEntries.findIndex((e: any) => e.id === entry.id);
const prevEntry = currentIndex < allEntries.length - 1 ? allEntries[currentIndex + 1] : null;
const nextEntry = currentIndex > 0 ? allEntries[currentIndex - 1] : null;
---

<BaseLayout
  title={`${entry.data.title} · Lane`}
  description={entry.data.description}
  type="article"
  published={entry.data.published}
  tags={entry.data.tags}
>
  <article class="article">
    <div class="article-meta reveal">
      <span class={`badge ${entry.data.status?.includes("完成") ? "badge-done" : "badge-active"}`}>
        {entry.data.status ?? "进行中"}
      </span>
      <span class="meta-sep">/</span>
      <span>约 {readingMinutes} 分钟读完</span>
      <span class="meta-sep">/</span>
      {entry.data.techStack.map((tag) => (
        <a href={`/tags/${tag}`}>#{tag}</a>
      ))}
    </div>

    <h1 class="reveal reveal-d1">{entry.data.title}</h1>
    <p class="lead reveal reveal-d2">{entry.data.description}</p>

    {(entry.data.repoUrl || entry.data.demoUrl || entry.data.techStack.length) && (
      <div class="terminal reveal reveal-d2" style="margin-bottom:36px">
        <div class="terminal-bar">
          <span class="dot dot-red"></span>
          <span class="dot dot-yellow"></span>
          <span class="dot dot-green"></span>
          <span class="terminal-title">project-info</span>
        </div>
        <div class="terminal-body">
          <div><span class="prompt">$</span> <span class="cmd">cat project.yaml</span></div>
          <div style="height:8px"></div>
          <div class="out">status: <span class={entry.data.status?.includes("完成") ? "ok" : "hl"}>{entry.data.status ?? "进行中"}</span></div>
          {entry.data.techStack.length > 0 && (
            <div class="out">stack: <span class="hl">{entry.data.techStack.join(" / ")}</span></div>
          )}
          {entry.data.repoUrl && (
            <div class="out">repo: <a href={entry.data.repoUrl} target="_blank" rel="noopener" style="color:inherit;text-decoration:underline;text-underline-offset:3px">github ↗</a></div>
          )}
          {entry.data.demoUrl && (
            <div class="out">demo: <a href={entry.data.demoUrl} target="_blank" rel="noopener" style="color:inherit;text-decoration:underline;text-underline-offset:3px">live demo ↗</a></div>
          )}
          <div style="height:6px"></div>
          <div><span class="prompt">$</span> <span class="cmd">echo $STATUS</span></div>
          <div class="out">→ <span class="ok">● active development</span><span class="cursor-blink"></span></div>
        </div>
      </div>
    )}

    <div class="article-content reveal reveal-d3">
      <Content />
    </div>

    <nav class="post-nav reveal" aria-label="项目导航">
      {prevEntry && (
        <a href={`/programs/${prevEntry.id}`} class="post-nav-prev">
          <span class="post-nav-label">← 上一个项目</span>
          <span class="post-nav-title">{prevEntry.data.title}</span>
        </a>
      )}
      {!prevEntry && <div class="post-nav-empty"></div>}
      {nextEntry && (
        <a href={`/programs/${nextEntry.id}`} class="post-nav-next">
          <span class="post-nav-label">下一个项目 →</span>
          <span class="post-nav-title">{nextEntry.data.title}</span>
        </a>
      )}
    </nav>
  </article>
</BaseLayout>
